# Netlify DB (Neon). Provision with `netlify db init` (or the Netlify dashboard).
# Once the site is linked, `netlify dev` and deploys inject NETLIFY_DATABASE_URL
# automatically — you do NOT need to set it by hand for `netlify dev`.
#
# For standalone tooling that runs OUTSIDE `netlify dev` (drizzle-kit migrate,
# tsx seed), provide the connection string here. Retrieve it with:
#   netlify env:get NETLIFY_DATABASE_URL
NETLIFY_DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Optional alternative name if you prefer setting it yourself:
# DATABASE_URL=

# Secret for signing session JWTs (generate: openssl rand -base64 32)
JWT_SECRET=

# Initial password for the bootstrapped super-admin (epena@fallbrookchurch.org).
# If unset, the super-admin account is NOT created by the seed.
SUPER_ADMIN_INITIAL_PASSWORD=

# Planning Center — Personal Access Token (read-only).
# Create at https://api.planningcenteronline.com/oauth/applications →
# "Personal Access Tokens". Used server-side only; never exposed to the client.
PCO_APP_ID=
PCO_SECRET=
