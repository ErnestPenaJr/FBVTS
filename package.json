{
  "name": "fbvts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Volunteer Scheduler — mobile-first volunteer & event sign-up app",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
